{
  "name": "@piplup/cache-buster",
  "version": "3.2.5",
  "private": false,
  "description": "Reload React apps when a new release is deployed: compares a build-time release ID and reloads stale tabs once.",
  "keywords": [
    "cache buster",
    "cache busting",
    "deploy",
    "new version",
    "react cache busting",
    "react-cache-buster",
    "release",
    "reload after deploy",
    "stale cache"
  ],
  "homepage": "https://www.piplupjs.com/docs/cache-buster/installation",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/piplupjs/piplup-cache-buster.git",
    "directory": "packages/cache-buster"
  },
  "bin": {
    "piplup-cache-buster": "./bin/generate-release-id.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.0"
  },
  "peerDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": false
    }
  }
}
