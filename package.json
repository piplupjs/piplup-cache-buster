{
  "name": "piplup-cache-buster",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --build --noEmit",
    "build": "npm run build -w @piplup/cache-buster && npm run build -w @piplup/vite-plugin-cache-buster",
    "release": "tsx scripts/release.mts",
    "release:dry": "tsx scripts/release.mts --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@piplup/code-infra": "^2.0.2",
    "@types/node": "^25.9.9",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
